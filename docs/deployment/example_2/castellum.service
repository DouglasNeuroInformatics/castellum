[Unit]
Description=gunicorn daemon for serving castellum
BindsTo=castellum.socket
After=castellum.socket
After=network.target

[Service]
# CHANGEME: Group setting below must match nginx default group, see /etc/nginx/nginx.conf
Group=nginx
EnvironmentFile=/etc/castellum/credentials.secret
Environment="DJANGO_SETTINGS_MODULE=castellum.settings.deployment"
WorkingDirectory=/opt/castellum
ExecStartPre=+mkdir -p /opt/castellum/media
ExecStartPre=+chown -R castellum:nginx /opt/castellum/media
ExecStartPre=+chmod -R 750 /opt/castellum/media
ExecStart=gunicorn \
          --access-logfile - \
          --workers 4 \
          --bind unix:/run/castellum.sock \
          castellum.wsgi:application

DynamicUser=true
ReadWritePaths=/opt/castellum/media
CapabilityBoundingSet=
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
