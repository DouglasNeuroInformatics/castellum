msgstr "Alle von diesen"

#: castellum/studies/templates/studies/filtergroup.html:45
#: castellum/studies/templates/studies/filtergroup_advanced.html:14
#: castellum/studies/templates/studies/study_other_studies.html:12
msgid "required"
msgstr "benötigt"

#: castellum/studies/templates/studies/filtergroup.html:45
#: castellum/studies/templates/studies/filtergroup_advanced.html:14
#: castellum/studies/templates/studies/study_other_studies.html:12
msgid "total"
msgstr "gesamt"

