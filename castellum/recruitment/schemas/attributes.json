{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "AttributeDescriptionExport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "descriptions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Description"
                    }
                }
            },
            "required": [
                "descriptions"
            ],
            "title": "AttributeDescriptionExport"
        },
        "Description": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "field_type": {
                    "type": "string",
                    "enum": [
                        "CharField",
                        "ChoiceField",
                        "MultipleChoiceField",
                        "OrderedChoiceField",
                        "IntegerField",
                        "BooleanField",
                        "DateField",
                        "AgeField"
                    ]
                },
                "privacy_level_read": {
                    "type": "integer"
                },
                "privacy_level_write": {
                    "type": "integer"
                },
                "order": {
                    "type": "integer"
                },
                "label": {
                    "$ref": "#/$defs/TranslatedString"
                },
                "choices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Choice"
                    }
                },
                "_filter_label": {
                    "$ref": "#/$defs/TranslatedString"
                },
                "help_text": {
                    "$ref": "#/$defs/TranslatedText"
                }
            },
            "required": [
                "field_type",
                "label"
            ],
            "title": "Description"
        },
        "Choice": {
            "type": "object",
            "properties": {
                "label": {
                    "$ref": "#/$defs/TranslatedString"
                }
            },
            "required": [
                "label"
            ],
            "title": "Choice"
        },
        "TranslatedString": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
                "..": {
                    "type": "string",
                    "maxLength": 64
                }
            },
            "title": "Label"
        },
        "TranslatedText": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
                "..": {
                    "type": "string"
                }
            },
            "title": "Label"
        }
    }
}
