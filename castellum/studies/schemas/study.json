{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "Person": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 128
                },
                "username": {
                    "type": "string",
                    "maxLength": 150
                },
                "name": {
                    "type": "string",
                    "maxLength": 128
                }
            },
            "anyOf": [{
                "required": ["email"]
            }, {
                "required": ["name"]
            }]
        },
        "Study": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 128
                },
                "contact_person": {
                    "$ref": "#/$defs/Person"
                },
                "principal_investigator": {
                    "$ref": "#/$defs/Person"
                },
                "affiliated_scientists": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Person"
                    }
                },
                "affiliated_research_assistants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Person"
                    }
                },
                "description": {
                    "type": "string"
                },
                "keywords": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "maxLength": 128
                    }
                },
                "sessions_start": {
                    "type": "string",
                    "format": "date"
                },
                "sessions_end": {
                    "type": "string",
                    "format": "date"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "not_started",
                        "started",
                        "data_collected",
                        "finished"
                    ]
                },
                "number_participants_expected": {
                    "type": "number"
                },
                "type": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "Online",
                            "Behavioral lab",
                            "MRI",
                            "Simulation",
                            "EEG",
                            "3rd party"
                        ]
                    }
                },
                "members": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Person"
                    }
                }
            },
            "required": ["name"]
        }
    }
}
