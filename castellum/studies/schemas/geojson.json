{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "PolygonCoordinates": {
            "type": "array",
            "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "Polygon": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "Polygon"
                },
                "coordinates": {
                    "$ref": "#/$defs/PolygonCoordinates"
                }
            }
        },
        "MultiPolygon": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "MultiPolygon"
                },
                "coordinates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/MultiPolygon"
                    }
                }
            }
        },
        "Feature": {
            "type": "object",
            "required": ["type", "properties", "geometry"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "Feature"
                },
                "properties": {
                    "oneOf": [
                        {"type": "null"},
                        {"type": "object"}
                    ]
                },
                "geometry": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "Polygon",
                                "MultiPolygon"
                            ]
                        }
                    },
                    "oneOf": [
                        {"$ref": "#/$defs/Polygon"},
                        {"$ref": "#/$defs/MultiPolygon"}
                    ]
                }
            }
        },
        "FeatureCollection": {
            "type": "object",
            "required": ["type", "features"],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "FeatureCollection"
                },
                "features": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Feature"
                    }
                }
            }
        },
        "geofilter": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "Feature",
                        "FeatureCollection"
                    ]
                }
            },
            "oneOf": [
                {"$ref": "#/$defs/Feature"},
                {"$ref": "#/$defs/FeatureCollection"}
            ]
        }
    }
}
