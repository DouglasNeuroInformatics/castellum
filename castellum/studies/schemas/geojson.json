{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "PolygonCoordinates": {
            "type": "array",
            "minItems": 4,
            "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                    "type": "number"
                }
            }
        },
        "Polygon": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["Polygon"]
                },
                "coordinates": {
                    "$ref": "#/$defs/PolygonCoordinates"
                }
            }
        },
        "MultiPolygon": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["MultiPolygon"]
                },
                "coordinates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/MultiPolygon"
                    }
                }
            }
        },
        "AnyPolygon": {
            "oneOf": [
                {"$ref": "#/$defs/Polygon"},
                {"$ref": "#/$defs/MultiPolygon"}
            ]
        }
    }
}
