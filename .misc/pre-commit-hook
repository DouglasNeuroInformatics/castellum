#!/bin/sh

tmp=$(mktemp -d)
trap 'rm -r "$tmp"' EXIT

nonempty() {
    while read -r path; do
        if [ -s "$path" ]; then
            echo "$path"
        fi
    done
}

# collecting files that should have license header
git ls-files castellum | grep py$ | grep -v migrations | grep -v settings | grep -v '[aw]sgi.py' | nonempty | sort > "${tmp}/expected"

# collecting files with license header
git grep -l '(c) 2018-2022' castellum | grep py$ | sort > "${tmp}/actual"

diff --unchanged-line-format="" "${tmp}/expected" "${tmp}/actual"
