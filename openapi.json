{
    "openapi": "3.1.1",
    "info": {
        "title": "Castellum API",
        "version": "1.0.0"
    },
    "security": [
        {
            "Bearer": []
        }
    ],
    "paths": {
        "/studies/api/studies/": {
            "get": {
                "summary": "Get a list of studies",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "edit",
                                "execution",
                                "finished"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "studies": {
                                            "type": "array",
                                            "items": {
                                                "type": "number"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/studies/api/studies/{study_id}/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "contact_person": {
                                            "$ref": "#/components/schemas/Person"
                                        },
                                        "description": {
                                            "type": "string"
                                        },
                                        "url": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": "TODO"
                                        },
                                        "sessions_start": {
                                            "type": "string"
                                        },
                                        "sessions_end": {
                                            "type": "string"
                                        },
                                        "number_participants_expected": {
                                            "type": "number"
                                        },
                                        "keywords": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "type": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "members": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Person"
                                            }
                                        },
                                        "principal_investigator": {
                                            "$ref": "#/components/schemas/Person"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/execution/api/studies/{study_id}/domains/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "domains": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "key": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/execution/api/studies/{study_id}/domains/{domain}/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "pseudonyms": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/execution/api/studies/{study_id}/domains/{domain}/{pseudonym}/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "pseudonym": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/execution/api/studies/{study_id}/domains/{domain}/{pseudonym}/attributes/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/execution/api/studies/{study_id}/domains/{domain}/{pseudonym}/{target_domain}/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "pseudonym": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/subjects/api/subjects/{domain}/{pseudonym}/attributes/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "scheme": "Bearer"
            }
        }
    }
}
